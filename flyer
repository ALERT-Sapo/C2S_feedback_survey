<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Compress to Success — Feedback Survey QR Code</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap');

:root{
  --navy: #16294B;
  --navy-deep: #0D1B33;
  --amber: #C97D2C;
  --ink-soft: #C8D0DE;
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:'Inter',sans-serif;
  background:transparent;
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:100vh;
  padding:20px;
}

.flyer{
  width:100%;
  max-width:420px;
  background:linear-gradient(160deg,var(--navy) 0%, var(--navy-deep) 100%);
  border-radius:18px;
  padding:34px 30px 30px;
  text-align:center;
  color:#fff;
  position:relative;
  overflow:hidden;
}
.flyer::after{
  content:"";
  position:absolute; right:-70px; top:-70px;
  width:220px; height:220px; border-radius:50%;
  border:14px solid rgba(201,125,44,0.18);
}
.eyebrow{
  font-family:'Barlow Condensed',sans-serif;
  font-weight:700; letter-spacing:.14em; text-transform:uppercase;
  color:var(--amber); font-size:13px; margin:0 0 6px; position:relative;
}
h1{
  font-family:'Barlow Condensed',sans-serif;
  font-weight:800; font-size:32px; line-height:1.05; margin:0 0 8px;
  letter-spacing:.01em; position:relative;
}
.sub{
  margin:0 0 26px; color:var(--ink-soft); font-size:13.5px;
  max-width:32ch; margin-left:auto; margin-right:auto; position:relative;
}

.qrcard{
  background:#fff; border-radius:14px; padding:20px;
  display:inline-block; position:relative;
}
#qrcode{ line-height:0; }
#qrcode img{ display:block; margin:0 auto; }

.hint{
  margin:18px 0 0; font-size:12px; color:var(--ink-soft);
  letter-spacing:.02em; position:relative;
}
.linktext{
  margin:6px 0 0; font-size:11px; color:var(--amber); word-break:break-all;
  position:relative;
}
.ctabtn{
  display:block; margin:22px auto 0; max-width:220px;
  background:var(--amber); color:#fff; font-family:'Inter'; font-weight:700;
  font-size:15px; text-decoration:none; padding:13px 20px; border-radius:9px;
  position:relative;
}
.ctabtn:hover{ background:#A8621B; }
</style>
</head>
<body>
  <div class="flyer">
    <p class="eyebrow">Compress to Success — ALERT Team</p>
    <h1>Tell us how it went</h1>
    <p class="sub">Scan to help us fine tune our workshop to your needs.</p>
    <div class="qrcard">
      <a href="https://alert-sapo.github.io/C2S_feedback_survey/" target="_blank" rel="noopener" style="display:block; text-decoration:none;">
        <div id="qrcode"></div>
      </a>
    </div>
    <a class="ctabtn" href="https://alert-sapo.github.io/C2S_feedback_survey/" target="_blank" rel="noopener">Take the survey →</a>
    <p class="hint">Takes about 2 minutes</p>
  </div>

<script>
const SURVEY_URL = "https://alert-sapo.github.io/C2S_feedback_survey/";
new QRCode(document.getElementById("qrcode"), {
  text: SURVEY_URL,
  width: 220,
  height: 220,
  colorDark: "#16294B",
  colorLight: "#ffffff",
  correctLevel: QRCode.CorrectLevel.M
});
</script>
</body>
</html>
